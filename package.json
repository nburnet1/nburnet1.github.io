{
  "name": "single-page-json-resume-template-builder",
  "version": "1.0.0",
  "description": "Static resume site using Mustache, JSON, and Tailwind",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node watch.js",
    "serve": "live-server public",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "resume:validate": "resumed validate resume.json",
    "resume:html": "resumed render resume.json --theme jsonresume-theme-noah --output public/resume.html",
    "resume:pdf": "resumed export resume.json --theme jsonresume-theme-noah --output public/Noah_Burnette_Resume.pdf"
  },
  "keywords": [
    "resume",
    "mustache",
    "tailwind",
    "static-site"
  ],
  "author": "Noah Burnette",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "chokidar": "^3.5.3",
    "fs-extra": "^11.1.1",
    "live-server": "^1.2.2",
    "mustache": "^4.2.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "puppeteer": "^25.16.0",
    "resumed": "^7.1.0",
    "jsonresume-theme-noah": "file:./theme"
  }
}
