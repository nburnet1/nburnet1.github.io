<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Books - {{ basics.name }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="Books {{ basics.name }} is reading, has read, and plans to read."/>
<link href="./index.css" rel="stylesheet" />
<link rel="icon" type="image/png" href="./favicon.ico">
<link rel="apple-touch-icon" href="./apple-touch-icon.png">
</head>

  <body class="bg-gray-900 text-gray-50">

    {{> nav }}

    <main class="max-w-6xl mx-auto px-6 py-10">
      <section id="books">
        <h1 class="font-bold text-4xl mb-3 text-gray-50">Books</h1>
        <p class="mb-6 text-gray-300">Here are some books that I've read and enjoyed. All of the read books I would highly recommend!</p>
        <div class="overflow-x-auto rounded-lg border border-gray-700">
          <table class="w-full text-left text-sm">
            <thead class="bg-gray-800 text-gray-100">
              <tr>
                <th class="px-4 py-2 font-semibold">Title</th>
                <th class="px-4 py-2 font-semibold">Author</th>
                <th class="px-4 py-2 font-semibold">Year</th>
              </tr>
            </thead>
            {{#bookshelf}}
              <tbody class="border-t border-gray-700">
                <tr class="bg-gray-800/50">
                  <th colspan="3" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400">{{ status }}</th>
                </tr>
                {{#books}}
                  <tr class="border-t border-gray-800">
                    <td class="px-4 py-2 text-gray-100">{{ title }}</td>
                    <td class="px-4 py-2 text-gray-300">{{ author }}</td>
                    <td class="px-4 py-2 text-gray-400">{{ year }}</td>
                  </tr>
                {{/books}}
              </tbody>
            {{/bookshelf}}
          </table>
        </div>
      </section>
    </main>

  </body>
</html>
